# HFB service configuration — copy to `.env` for local dev.
# NO real secrets in this file or in code (M15 §2). Prod/staging inject these
# from the secret manager; `.env` is git-ignored.

HFB_ENVIRONMENT=local
HFB_LOG_LEVEL=INFO
HFB_LOG_JSON=true

# Data stores (used from A2 onward). Defaults match docker-compose.yml.
HFB_DATABASE_URL=postgresql+psycopg://hfb:hfb@localhost:5432/hfb
HFB_REDIS_URL=redis://localhost:6379/0

# Celery (A7 Pending Queue / Scheduler)
HFB_CELERY_BROKER_URL=redis://localhost:6379/1
HFB_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Tracing baseline — off by default; needs the opentelemetry extras installed.
HFB_OTEL_ENABLED=false
HFB_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
